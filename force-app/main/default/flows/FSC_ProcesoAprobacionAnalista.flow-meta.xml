<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>IniciarInstanciasCredito</name>
        <label>Iniciar instancias de crédito</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FSC_InstanciasCreditoService</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>solicitudId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FSC_InstanciasCreditoService</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Instancias de crédito {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Proceso aprobación analista</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IniciarInstanciasCredito</targetReference>
        </connector>
        <filterFormula>AND(
ISPICKVAL({!$Record.FSC_Resultado_Buro__c}, &apos;Referido&apos;),
{!$Record.FSC_Doc_Completa_Analisis__c} = true,
{!$Record.FSC_DebeRevisarComite__c} = false,
{!$Record.FSC_DebeRevisarSupervisor__c} = false,
{!$Record.FSC_Aprobado_con_Condiciones__c} = false,
OR(
    AND(
        ISPICKVAL({!$Record.FSC_Subestado__c}, &apos;Recepción de documentos – Análisis&apos;),
        OR(
            ISCHANGED({!$Record.FSC_Resultado_Buro__c}),
            ISCHANGED({!$Record.FSC_Subestado__c}),
            ISCHANGED({!$Record.FSC_Doc_Completa_Analisis__c})
        )
    ),
    AND(
        ISPICKVAL({!$Record.FSC_Subestado__c}, &apos;Análisis de crédito&apos;),
        ISBLANK({!$Record.FSC_InstanciaAprobacion__c}),
        ISCHANGED({!$Record.FSC_DebeRevisarSupervisor__c})
    )
)
)</filterFormula>
        <object>ResidentialLoanApplication</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
