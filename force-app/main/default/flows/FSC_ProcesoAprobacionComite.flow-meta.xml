    <decisions>
        <name>Monto</name>
        <label>Monto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>GetColaComiteI</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Por defecto comité 1</defaultConnectorLabel>
        <rules>
            <name>Hasta_2_5M_PYME_o_7M_Otros</name>
            <conditionLogic>(1 AND 3) OR (2 AND NOT(3))</conditionLogic>
            <conditions>
                <leftValueReference>ObtenerMontoComite.monto</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2500000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObtenerMontoComite.monto</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>7000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FSC_Solicitud_Credito_PYME</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetColaComiteI</targetReference>
            </connector>
            <label>Hasta 2.5M PYME o 7M Otros</label>
        </rules>
        <rules>
            <name>Hasta_25M</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ObtenerMontoComite.monto</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.5E7</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetColaComiteII</targetReference>
            </connector>
            <label>Hasta 25M</label>
        </rules>
        <rules>
            <name>Hasta_100M</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ObtenerMontoComite.monto</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0E8</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetColaComiteIII</targetReference>
            </connector>
            <label>Hasta 100M</label>
        </rules>
    </decisions>
