<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Lead_NumIdentificacion_Requerido_PF</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    $RecordType.Name = &quot;Candidato Persona Física&quot;,
    ISBLANK(LEA_NumIdentificacion__c)
)</errorConditionFormula>
    <errorDisplayField>LEA_NumIdentificacion__c</errorDisplayField>
    <errorMessage>Debe completar el campo Número de Identificación para registrar el Candidato</errorMessage>
</ValidationRule>
