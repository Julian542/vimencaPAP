<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FSC_MontoCuotaRegular__c</fullName>
    <formula>IF(
    FSC_MontoDesembolsar__c &gt; 0, 
    FSC_MontoDesembolsar__c * (FSC_TasaInteres__c / 100 / 12)/(1 - (1 / (
        IF(
            (FSC_TasaInteres__c-1) &gt;= 0, 
            ((FSC_TasaInteres__c / 100 / 12) + 1) ^ FSC_PlazoMeses__c, 
            (FSC_TasaInteres__c / 100 / 12) + 1
        )))), 
    0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Monto de la Cuota Regular</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
