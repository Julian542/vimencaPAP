<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>FSC_NumeroPrestamoAbanks__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <label>FSC - Validación en Abanks</label>
        <name>FSC_PasoValidacionEnAbanks</name>
    </approvalStep>
    <description>FSC - Valida que el crédito se haya creado correctamente en Abanks antes del desembolso.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(
    ISPICKVAL(Status, &quot;En proceso&quot;),
    ISPICKVAL(FSC_Subestado__c, &quot;Creación de crédito&quot;),
    ISPICKVAL(FSC_FormaDeDesembolso__c, &quot;Cuenta de ahorro&quot;),
    NOT(ISBLANK(FSC_NumeroPrestamoAbanks__c))
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>FSC_SubestadoDesembolsoValAbanks</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>FSC - Validación en Abanks</label>
    <processOrder>11</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
