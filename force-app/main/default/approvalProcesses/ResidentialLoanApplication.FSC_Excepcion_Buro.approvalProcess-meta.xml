<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Account</field>
        <field>FSC_Tipo_de_solicitud__c</field>
        <field>FSC_Monto__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>FSC_Cola_Excepcion_Buro</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Revisión</label>
        <name>Revision</name>
    </approvalStep>
    <description>Proceso de aprobación para aprobar/rechazar una solicitud de excepción buró de crédito, cuando el buró retorna rechazado y el motivo aplica para una excepción</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>ResidentialLoanApplication.FSC_SolicitaExcepcionParaRechazoDeBuro__c</field>
            <operation>equals</operation>
            <value>Verdadero</value>
        </criteriaItems>
        <criteriaItems>
            <field>ResidentialLoanApplication.FSC_Subestado__c</field>
            <operation>equals</operation>
            <value>Rechazado por Buró</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>FSC_Asignar_Status_En_proceso</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FSC_AsignarSubstatusRecepcion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FSC_ExcepcionBuroAprobada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FSC_ResultadoBuroReferido</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>FSC_Asignar_Status_Cerrada_Perdida</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FSC_ExcepcionBuroRechazada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FSC_SubestadoRechazadoPorAnalistaDeCred</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Excepción Buró</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
