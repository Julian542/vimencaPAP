<apex:component layout="none">
	<style type="text/css">
		@page {
			size: letter;
			margin: 25.4mm;
			@bottom-center {
				content: element(contrato-pie-pagina);
				width: 100%;
			}
		}
		body {
			margin: 0;
			padding: 0;
			color: #000000;
			font-family: 'Arial Narrow', Arial, sans-serif;
			font-size: 11pt;
			/* Equivale al interlineado "Múltiple 1.2" de Word (1.2 x 1.15 de la métrica de Arial). */
			line-height: 1.38;
			counter-reset: articulo;
		}
		/* Numeración automática: solo cuentan los artículos que se muestran en el contrato. */
		.articulo {
			counter-increment: articulo;
		}
		.articulo:before {
			content: "ARTÍCULO " counter(articulo) ". ";
		}
		/* El pie se repite dentro del margen inferior de cada hoja. */
		.contrato-pie-pagina {
			position: running(contrato-pie-pagina);
			width: 100%;
			font-family: 'Arial Narrow', Arial, sans-serif;
			font-size: 7pt;
			line-height: 1.2;
			text-align: center;
		}
		.contrato-numero-pagina {
			margin-top: 1mm;
			font-size: 11pt;
			text-align: right;
		}
		.contrato-numero-pagina:before {
			content: counter(page);
		}
	</style>
</apex:component>