<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Cambiar_a_activo</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
				$Label.Validaciones =&apos;Si&apos;,
				ISPICKVAL(ACC_Estado__c,&apos;activo&apos;),
				ISCHANGEd(ACC_Estado__c),
				$User.Username &lt;&gt; &apos;vimenca.viseo@force.com&apos;,
				 ACC_Conteo_Cuentas_financieras_activas__c = 0)</errorConditionFormula>
    <errorMessage>No puede cambiar el estado del cliente a activo ya que no tiene cuentas creadas</errorMessage>
</ValidationRule>
